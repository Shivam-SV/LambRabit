# Versions built by .github/workflows/binaries.yml, with the sha256 of every source
# tarball. Bump a version here (and its checksum) to publish a new build.

# Web servers: one or more versions each, space-separated.
NGINX_VERSIONS="1.30.6 1.31.8"
APACHE_VERSIONS="2.4.69"
# PHP: release lines; static-php-cli builds the newest patch release of each.
PHP_LINES="8.1 8.2 8.3 8.4 8.5"
# Redis for Linux and macOS (Windows uses the community redis-windows build). 7.2 is the
# last BSD-licensed line; 8.x is AGPLv3 (among its licence options), so the source is
# linked from the release.
REDIS_VERSIONS="8.10.3 7.2.17"
REDIS_SHA256_8_10_3="edde778f6bdee7581e42fc139ca9e07e2822212092f7501f99989656e3629d02"
REDIS_SHA256_7_2_17="07c679c013fd82513299733bddf91999bbbc830351ec9ea985a533b09a595d76"
# Memcached: built from source for Linux and macOS with libevent compiled in. Windows gets
# nono303's Cygwin build, repackaged with its checksum checked (GitHub's archive of the
# tag; that project publishes no release files).
MEMCACHED_VERSIONS="1.6.45"
MEMCACHED_SHA256_1_6_45="d362c64e6d8d5287153501eabf7c85b4a761432fbf53f5d7b085d0bb1653c1dd"
MEMCACHED_WINDOWS_SHA256_1_6_45="b15c03ad74dd13cae869f4abf3fe5ea3038deb8b5a7f8592622773fff0193926"
LIBEVENT_VERSION="2.1.12"
LIBEVENT_SHA256="92e6de1be9ec176428fd2367677e61ceffc2ee1cb119035037a27d346b0403bb"

# Sources. nginx.org publishes PGP signatures only; build-nginx.sh checks them against
# the release managers' keys below.
NGINX_KEYS="https://nginx.org/keys/arut.key https://nginx.org/keys/pluknet.key https://nginx.org/keys/sb.key https://nginx.org/keys/thresh.key"
HTTPD_SHA256_2_4_69="c5e6ebc66e349b87d7fc6916ae7cc2a808ed348003de134cf9e9d89d3e2cc73d"

APR_VERSION="1.7.6"
APR_SHA256="49030d92d2575da735791b496dc322f3ce5cff9494779ba8cc28c7f46c5deb32"
APR_UTIL_VERSION="1.6.5"
APR_UTIL_SHA256="96de1dd6f6a0476d2d2e7964926d8c1ddc3bb0e210e1b1812d3ba5a454a392e2"
OPENSSL_VERSION="3.5.9"
OPENSSL_SHA256="603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a"
PCRE2_VERSION="10.49"
PCRE2_SHA256="929f0b20e62879252a15886b06c89f1edef61a363cbd5826fb041080a5e557ae"
ZLIB_VERSION="1.3.2"
ZLIB_SHA256="bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16"
EXPAT_VERSION="2.9.0"
EXPAT_SHA256="16afbb9cefead2aa278105cf27d9f597bde7fbf3dbb85015857ca7ca6a4e89ba"

# static-php-cli, the tool that builds PHP (fully static, so it runs on any distro).
SPC_VERSION="2.8.5"
SPC_SHA256_LINUX_X86_64="523ba4279c54c7a377156c0dd3a36adf92ee64b01e9a7f5e9e2ec084b8e458e5"
SPC_SHA256_LINUX_AARCH64="675a3840dcdc4ed041fe20eaa54310ce019a9984c1c03951df9ec66df5795213"
SPC_SHA256_MACOS_X86_64="e8b798048f62ca4960764196543b60ae703f7174aa418824cf542aeec1d2cd6a"
SPC_SHA256_MACOS_AARCH64="acf2f25d56d0cbf8e65aa82e5054fef555f7be7c5c38046c6e0819f266d83225"
# Compiled into every PHP build. Mirrors what the Windows builds ship plus the common
# PECL caches, so Laravel, Symfony and WordPress run without changes. Static builds can't
# load extensions later, so Redis and Memcached clients (with igbinary) are built in.
PHP_EXTENSIONS="bcmath,calendar,ctype,curl,dom,exif,fileinfo,filter,ftp,gd,gettext,iconv,igbinary,intl,mbstring,memcached,mysqli,mysqlnd,opcache,openssl,pcntl,pdo,pdo_mysql,pdo_sqlite,phar,posix,readline,redis,session,simplexml,soap,sockets,sodium,sqlite3,tokenizer,xml,xmlreader,xmlwriter,xsl,zip,zlib"
