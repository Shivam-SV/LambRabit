{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lampRabit",
  "version": "0.1.0",
  "identifier": "dev.lamprabit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lampRabit",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBODJGOUY2QkY5RjU2QkIKUldTN1ZwKy85dm1DQ2h6VjdINnNMdlc2N3lFbVZBaTN5bzByUWFsdTRXdXAzYTd3MkREb3lXbzgK",
      "endpoints": [
        "https://github.com/Shivam-SV/LambRabit/releases/latest/download/latest.json"
      ]
    }
  }
}
