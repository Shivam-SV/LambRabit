{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LampRabit",
  "version": "0.1.2",
  "identifier": "dev.lamprabit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LampRabit",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "LampRabit",
    "category": "DeveloperTool",
    "shortDescription": "Local PHP development environment: Apache or Nginx, PHP and MariaDB with automatic .test sites",
    "longDescription": "LampRabit runs a complete local PHP stack: Apache or Nginx, several PHP versions side by side, MariaDB, Redis, Mailpit and database tools. Every folder in www becomes https://<folder>.test with a trusted local certificate.",
    "copyright": "© 2026 LampRabit contributors",
    "homepage": "https://github.com/Shivam-SV/LampRabit",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/cleanup.wxs"],
        "componentRefs": ["LampRabitCleanup"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBODJGOUY2QkY5RjU2QkIKUldTN1ZwKy85dm1DQ2h6VjdINnNMdlc2N3lFbVZBaTN5bzByUWFsdTRXdXAzYTd3MkREb3lXbzgK",
      "endpoints": [
        "https://github.com/Shivam-SV/LampRabit/releases/latest/download/latest.json",
        "https://github.com/Shivam-SV/LambRabit/releases/latest/download/latest.json"
      ]
    }
  }
}
